# --- Ollama (primary LLM) ---
OLLAMA_BASE_URL=http://192.168.10.33:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=60

# --- Cloud LLM fallback ---
# provider: one of "xai", "google", "anthropic"
FALLBACK_PROVIDER=xai
FALLBACK_API_KEY=
FALLBACK_MODEL=grok-3-latest

# --- Twilio (phone/AVR) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Speech ---
# STT: "whisper-local" or "whisper-api"
STT_PROVIDER=whisper-local
STT_API_KEY=

# TTS: "cartesia" or "elevenlabs"
TTS_PROVIDER=cartesia
TTS_API_KEY=
TTS_VOICE_ID=

# --- QuickBooks Online (accounting) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox

# --- Email (outbound SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Oak & Partners Intake
# If set, all outbound emails are redirected to this address (demo mode).
EMAIL_DEMO_REDIRECT=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to talk to the bot (others silently dropped).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- App ---
DATABASE_URL=sqlite:///./data/orchestrator.db
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
