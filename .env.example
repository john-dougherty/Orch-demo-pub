# --- Ollama (primary LLM) ---
OLLAMA_BASE_URL=http://XXX.XXX.XX.XX:00000
OLLAMA_MODEL=XXXXXX:00X
OLLAMA_TIMEOUT_SECONDS=00

# --- Cloud LLM fallback ---
# provider: one of "xai", "google", "anthropic"
FALLBACK_PROVIDER=XXX
FALLBACK_API_KEY=XXXXXX-XXXX000-XXX00-XXX
FALLBACK_MODEL=XXXX-0-XXXXXX

# --- Twilio (phone/AVR) ---
TWILIO_ACCOUNT_SID=XX00000000000000000000000000000000
TWILIO_AUTH_TOKEN=XX00000000000000000000000000000000
TWILIO_PHONE_NUMBER=+0-000-000-0000

# --- Speech ---
# STT: "whisper-local" or "whisper-api"
STT_PROVIDER=XXXXXXX-XXXXX
STT_API_KEY=XXXXXX-XXXX000-XXX00-XXX

# TTS: "cartesia" or "elevenlabs"
TTS_PROVIDER=XXXXXXXX
TTS_API_KEY=XXXXXX-XXXX000-XXX00-XXX
TTS_VOICE_ID=XXXXXX-XXXX000-XXX00-XXX

# --- QuickBooks Online (accounting) ---
QBO_CLIENT_ID=XX00000000000000000000000000000000
QBO_CLIENT_SECRET=XX00000000000000000000000000000000
QBO_REFRESH_TOKEN=XX00000000000000000000000000000000
QBO_ACCESS_TOKEN=XX00000000000000000000000000000000
QBO_REALM_ID=0000000000000000000
QBO_ENVIRONMENT=sandbox

# --- Email (outbound SMTP) ---
SMTP_HOST=XXXX.XXXXX.XXX
SMTP_PORT=000
SMTP_USER=XXXXX@XXXXX.XXX
SMTP_PASSWORD=XXXXXX-XXXX000-XXX00-XXX
SMTP_FROM_ADDRESS=XXXXX@XXXXX.XXX
SMTP_FROM_NAME=XXX & XXXXXXXX XXXXXX
# If set, all outbound emails are redirected to this address (demo mode).
EMAIL_DEMO_REDIRECT=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Comma-separated chat IDs allowed to talk to the bot (others silently dropped).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- App ---
DATABASE_URL=XXXXXX:///./XXXX/XXXXXXXXXXXX.XX
PUBLIC_BASE_URL=XXXX://XXXXXXXXX:0000
LOG_LEVEL=XXXX
